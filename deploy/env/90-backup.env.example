BACKUP_ROOT=/mnt/backup/lab/archive
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=12
BACKUP_REMOTE_TARGET=
BACKUP_MINIO_ALIAS=local
BACKUP_DRY_RUN_DEFAULT=true

# Phase 7 active-stack operational baseline backups.
# These defaults target the active Huly workspace MVP modules, not the archived
# Plane/Gitea/Nextcloud/MLflow direction.
LABSTACK_BACKUP_POSTGRES=true
LABSTACK_BACKUP_CORE_REDIS=true
LABSTACK_BACKUP_AUTHENTIK=true
LABSTACK_BACKUP_EDGE_METADATA=true
LABSTACK_BACKUP_SHARED_MINIO=true
LABSTACK_BACKUP_HULY=true
LABSTACK_BACKUP_OVERLEAF=true
LABSTACK_BACKUP_LEGACY_GITEA=false
LABSTACK_BACKUP_LEGACY_NEXTCLOUD=false
LABSTACK_BACKUP_LEGACY_MINIO=false

# Huly backup is a cold archive because the active Huly runtime owns
# CockroachDB, Redpanda, internal MinIO, Elastic, and app state. Set this only
# during a maintenance window.
PHASE7_ALLOW_HULY_STOP=false

# Restore rehearsal writes into a temporary MinIO bucket and removes it. Set to
# false to limit the MinIO rehearsal to archive extraction/listing.
PHASE7_RESTORE_MINIO_WRITE=true

PHASE7_REQUIRE_BACKUP_EVIDENCE=true
PHASE7_REQUIRE_RESTORE_REHEARSAL=true
PHASE7_DISK_WARN_PERCENT=85
PHASE7_DISK_FAIL_PERCENT=95
PHASE7_CERT_WARN_DAYS=30
PHASE7_CERT_FAIL_DAYS=7
