# Phase 4 shared MinIO storage surface.
# Copy to /opt/lab-stack/env/35-minio-storage.env and keep generated secrets in
# /opt/lab-stack/env/20-authentik.env and /opt/lab-stack/env/10-core.env only.

MINIO_ALIAS=labminio

MINIO_STORAGE_BUCKET_MODELS=lab-models
MINIO_STORAGE_BUCKET_DATASETS=lab-datasets
MINIO_STORAGE_BUCKET_ARTIFACTS=lab-artifacts
MINIO_STORAGE_BUCKET_PUBLIC=lab-public
MINIO_STORAGE_BUCKET_BACKUPS=lab-backups
MINIO_STORAGE_BUCKETS=${MINIO_STORAGE_BUCKET_MODELS},${MINIO_STORAGE_BUCKET_DATASETS},${MINIO_STORAGE_BUCKET_ARTIFACTS},${MINIO_STORAGE_BUCKET_PUBLIC},${MINIO_STORAGE_BUCKET_BACKUPS}
MINIO_STORAGE_VERSIONING_BUCKETS=${MINIO_STORAGE_BUCKETS}
MINIO_STORAGE_MEMBER_RW_BUCKETS=${MINIO_STORAGE_BUCKET_MODELS},${MINIO_STORAGE_BUCKET_DATASETS},${MINIO_STORAGE_BUCKET_ARTIFACTS},${MINIO_STORAGE_BUCKET_PUBLIC}
MINIO_STORAGE_HF_UI_RW_BUCKETS=${MINIO_STORAGE_BUCKET_MODELS},${MINIO_STORAGE_BUCKET_DATASETS},${MINIO_STORAGE_BUCKET_ARTIFACTS},${MINIO_STORAGE_BUCKET_PUBLIC}

MINIO_POLICY_MEMBER_RW=lab-storage-member-rw
MINIO_POLICY_PUBLIC_READ=lab-public-read
MINIO_POLICY_HF_UI_RW=hf-ui-storage-rw

MINIO_IDENTITY_OPENID_CONFIG_URL=https://${AUTH_DOMAIN}/application/o/minio/.well-known/openid-configuration
MINIO_IDENTITY_OPENID_DISPLAY_NAME=Authentik
MINIO_IDENTITY_OPENID_SCOPES=openid,email,profile,groups,policy
MINIO_IDENTITY_OPENID_CLAIM_NAME=policy

MINIO_STORAGE_SMOKE_BUCKET=${MINIO_STORAGE_BUCKET_ARTIFACTS}
MINIO_STORAGE_SMOKE_PREFIX=smoke/phase4
MINIO_BACKUP_SMOKE_BUCKET=${MINIO_STORAGE_BUCKET_BACKUPS}
MINIO_BACKUP_SMOKE_PREFIX=smoke/phase4-backup
MINIO_BACKUP_SMOKE_ROOT=${LAB_BACKUP_ROOT}/minio-smoke

PHASE4_REQUIRE_REAL_DOMAINS=true
