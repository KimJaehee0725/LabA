OVERLEAF_IMAGE=sharelatex/sharelatex:5.0.8
OVERLEAF_CUSTOM_IMAGE=lab/overleaf-ce:phase6
OVERLEAF_MONGO_IMAGE=mongo:6
OVERLEAF_REDIS_IMAGE=redis:7-alpine
OVERLEAF_APP_NAME=Lab Overleaf
OVERLEAF_ADMIN_EMAIL=admin@example.edu
OVERLEAF_SITE_URL=https://overleaf.lab.example.ac.kr
OVERLEAF_NAV_TITLE=Lab Overleaf
OVERLEAF_SESSION_SECRET=change-me-generate-on-server
OVERLEAF_MONGO_DB=sharelatex
OVERLEAF_REDIS_PASSWORD=change-me-generate-on-server
OVERLEAF_SMTP_HOST=smtp.example.edu
OVERLEAF_SMTP_PORT=587
OVERLEAF_SMTP_SECURE=false
OVERLEAF_SMTP_USER=change-me-on-server
OVERLEAF_SMTP_PASSWORD=change-me-on-server
OVERLEAF_SMTP_FROM=overleaf@example.edu
OVERLEAF_SMTP_TLS_REJECT_UNAUTH=true
OVERLEAF_RESTRICT_INVITES_TO_EXISTING_ACCOUNTS=false
OVERLEAF_TRUSTED_PROXY_IPS=loopback,172.16.0.0/12
