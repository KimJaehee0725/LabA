NEXTCLOUD_IMAGE=nextcloud:30-apache
COLLABORA_IMAGE=collabora/code:24.04.12.4.1
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud_user
NEXTCLOUD_DB_PASSWORD=change-me-generate-on-server
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me-generate-on-server
NEXTCLOUD_REDIS_DB=3
NEXTCLOUD_TRUSTED_PROXIES=nginx
NEXTCLOUD_UPLOAD_LIMIT=10G
NEXTCLOUD_OIDC_CLIENT_ID=nextcloud
NEXTCLOUD_OIDC_CLIENT_SECRET=change-me-after-authentik-provider
NEXTCLOUD_OIDC_GROUP_WHITELIST_REGEX="^lab-(admin|member|collab|guest)$"
NEXTCLOUD_OIDC_GROUP_PROVISIONING=1
NEXTCLOUD_OIDC_GROUP_RESTRICT_LOGIN=1
NEXTCLOUD_SEED_USER=admin
NEXTCLOUD_SEED_APP_PASSWORD=change-me-runtime-only
NEXTCLOUD_DOC_GROUP_FOLDER_NAME="Lab Demo Documents"
COLLABORA_USERNAME=admin
COLLABORA_PASSWORD=change-me-generate-on-server
