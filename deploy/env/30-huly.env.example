# Huly self-host Phase 3.
# Copy to /opt/lab-stack/env/30-huly.env and replace placeholders on the server.

HULY_VERSION=v0.7.423
HULY_DESKTOP_CHANNEL=0.7.423
HULY_TITLE="Huly Lab Workspace"
HULY_DEFAULT_LANGUAGE=en
HULY_LAST_NAME_FIRST=true
HULY_DISABLED_FEATURES=auto-translate,mailboxes
HULY_DISABLE_SIGNUP=true
HULY_OIDC_TLS_REJECT_UNAUTHORIZED=1

HULY_COCKROACH_IMAGE=cockroachdb/cockroach:latest-v24.2
HULY_COCKROACH_DATABASE=defaultdb
HULY_COCKROACH_USER=selfhost
HULY_COCKROACH_PASSWORD=change-me-generate-on-server

HULY_REDPANDA_IMAGE=docker.redpanda.com/redpandadata/redpanda:v24.3.6
HULY_REDPANDA_ADMIN_USER=superadmin
HULY_REDPANDA_ADMIN_PASSWORD=change-me-generate-on-server

HULY_MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
HULY_MINIO_ROOT_USER=hulyminio
HULY_MINIO_ROOT_PASSWORD=change-me-generate-on-server

HULY_ELASTIC_IMAGE=elasticsearch:7.14.2
HULY_ELASTIC_JAVA_OPTS="-Xms1024m -Xmx1024m"
HULY_MONGO_IMAGE=mongo:7-jammy

HULY_SERVER_SECRET=change-me-generate-on-server
HULY_MAIL_URL=

# Huly consumes the HULY_OIDC_* values from 20-authentik.env.
# Required Authentik redirect URI:
# https://huly.lab.example.ac.kr/_accounts/auth/openid/callback

HULY_ENABLE_GITHUB=true
HULY_GITHUB_APP_ID=change-me-on-server
HULY_GITHUB_APP_SLUG=change-me-on-server
HULY_GITHUB_CLIENT_ID=change-me-on-server
HULY_GITHUB_CLIENT_SECRET=change-me-on-server
HULY_GITHUB_WEBHOOK_SECRET=change-me-generate-on-server
HULY_GITHUB_PRIVATE_KEY=change-me-store-pem-only-on-server-or-use-file
HULY_GITHUB_PRIVATE_KEY_FILE=/opt/lab-stack/secrets/huly/github-app.private-key.pem

HULY_ENABLE_CALENDAR=true
HULY_GOOGLE_CALENDAR_CREDENTIALS=change-me-json-only-on-server-or-use-file
HULY_GOOGLE_CALENDAR_CREDENTIALS_FILE=/opt/lab-stack/secrets/huly/google-calendar-oauth.json
