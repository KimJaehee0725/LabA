PLANE_SOURCE_REF=f70eae2f3be48b3cfb6ed579ef587c2a86a1c56b
PLANE_WEB_IMAGE=lab-plane-frontend:v0.25.0-authentik-oidc
PLANE_SPACE_IMAGE=makeplane/plane-space:v0.25.0
PLANE_ADMIN_IMAGE=makeplane/plane-admin:v0.25.0
PLANE_API_IMAGE=lab-plane-backend:v0.25.0-authentik-oidc
PLANE_LIVE_IMAGE=makeplane/plane-live:v0.25.0
PLANE_WEB_URL=https://lab.snu.ac.kr
PLANE_DB_NAME=plane
PLANE_DB_USER=plane_user
PLANE_DB_PASSWORD=change-me-generate-on-server
PLANE_REDIS_DB=2
PLANE_SECRET_KEY=change-me-generate-on-server
PLANE_S3_BUCKET=plane-uploads
PLANE_S3_ENDPOINT=http://minio:9000
PLANE_S3_REGION=us-east-1
PLANE_OIDC_DISCOVERY_URL=https://auth.lab.snu.ac.kr/application/o/plane/.well-known/openid-configuration
PLANE_OIDC_CLIENT_ID=plane
PLANE_OIDC_CLIENT_SECRET=change-me-after-authentik-provider
PLANE_OIDC_SCOPES="openid email profile groups"
# With the internal CA certificate generated by 05-create-internal-ca-cert.sh,
# plane-api mounts lab-internal-ca.crt and uses REQUESTS_CA_BUNDLE for OIDC HTTPS.
PLANE_OIDC_VERIFY_SSL=1
PLANE_OIDC_PROVIDER_LABEL=Authentik
PLANE_INSTANCE_NAME="Lab Plane"
PLANE_ENABLE_SIGNUP=0
PLANE_ENABLE_EMAIL_PASSWORD=1
PLANE_DISABLE_WORKSPACE_CREATION=0
PLANE_ENABLE_MAGIC_LINK_LOGIN=0
PLANE_IS_INTERCOM_ENABLED=0
PLANE_FILE_SIZE_LIMIT=5242880
