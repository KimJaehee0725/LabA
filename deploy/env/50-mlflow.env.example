# Phase 8 MLflow tracking MVP.
# Copy to /opt/lab-stack/env/50-mlflow.env and replace all change-me values.

MLFLOW_IMAGE=lab/mlflow-server:phase8
MLFLOW_VERSION=2.20.3
MLFLOW_CONTAINER=mlflow
MLFLOW_PORT=5000

MLFLOW_DB_NAME=mlflow
MLFLOW_DB_USER=mlflow_user
MLFLOW_DB_PASSWORD=change-me-generate-on-server

MLFLOW_S3_ENDPOINT_URL=http://minio:9000
MLFLOW_S3_REGION=us-east-1
MLFLOW_S3_BUCKET=lab-artifacts
MLFLOW_S3_ARTIFACT_PREFIX=mlflow
MLFLOW_MINIO_POLICY=mlflow-artifacts-rw
MLFLOW_S3_ACCESS_KEY=change-me-generate-on-server
MLFLOW_S3_SECRET_KEY=change-me-generate-on-server

MLFLOW_SMOKE_EXPERIMENT=phase8-smoke
MLFLOW_SMOKE_ARTIFACT_PREFIX=smoke/phase8-mlflow

# Public MLflow UI must stay disabled or Authentik-gated. Internal checks pass
# with PHASE8_REQUIRE_AUTH_GATE=false; strict edge checks require this to be true.
PHASE8_REQUIRE_AUTH_GATE=false
MLFLOW_EDGE_ENABLED=false
AUTHENTIK_OUTPOST_IMAGE=ghcr.io/goauthentik/proxy:2025.2.4
AUTHENTIK_OUTPOST_MLFLOW_TOKEN=change-me-after-authentik-outpost
