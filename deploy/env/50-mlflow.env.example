MLFLOW_IMAGE=lab/mlflow-server:v0.2
MLFLOW_VERSION=2.20.3
MLFLOW_DB_NAME=mlflow
MLFLOW_DB_USER=mlflow_user
MLFLOW_DB_PASSWORD=change-me-generate-on-server
MLFLOW_S3_BUCKET=mlflow-artifacts
MLFLOW_S3_ENDPOINT=http://minio:9000
MLFLOW_S3_ACCESS_KEY=change-me-after-minio-bootstrap
MLFLOW_S3_SECRET_KEY=change-me-after-minio-bootstrap
MLFLOW_INTERNAL_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_INTERNAL_HOST=http://mlflow:5000
MLFLOW_EXTERNAL_HOST=https://mlflow.lab.snu.ac.kr
MLFLOW_PROXY_PROVIDER_NAME=mlflow-proxy
MLFLOW_OUTPOST_NAME=mlflow-outpost
AUTHENTIK_OUTPOST_IMAGE=ghcr.io/goauthentik/proxy:2025.2.4
AUTHENTIK_OUTPOST_MLFLOW_TOKEN=change-me-after-authentik-outpost
