# Phase 5 HF-like UI MVP.
# Copy to /opt/lab-stack/env/45-hf-ui.env and replace generated values only on
# the server. Do not commit real service keys, session secrets, or OIDC secrets.

HF_UI_IMAGE=lab/hf-ui:phase5
HF_UI_CONTAINER=hf-ui
HF_UI_PORT=8080
HF_UI_PUBLIC_URL=https://${HF_DOMAIN}
HF_UI_API_BASE=/api
HF_UI_VERSION=phase5-mvp

HF_UI_SESSION_SECRET=change-me-generate-on-server
HF_UI_AUTH_REQUIRED=true
HF_UI_ALLOW_STAGING_BYPASS=false
HF_UI_STAGING_BYPASS_TOKEN=change-me-generate-on-server

HF_UI_OIDC_ISSUER=https://${AUTH_DOMAIN}/application/o/hf-ui/
HF_UI_OIDC_REDIRECT_URI=https://${HF_DOMAIN}/oauth/callback
HF_UI_OIDC_SCOPES="openid email profile groups"

HF_UI_CATALOG_FILE=/app/catalog/seed.catalog.yaml
HF_UI_DEFAULT_VISIBILITY=lab
HF_UI_REQUIRE_GROUPS=lab-admin,lab-member,lab-collab

HF_UI_S3_ENDPOINT=minio:9000
HF_UI_S3_SECURE=false
HF_UI_S3_PUBLIC_ENDPOINT=${S3_DOMAIN}
HF_UI_S3_PUBLIC_SECURE=true
HF_UI_S3_REGION=us-east-1
HF_UI_S3_ACCESS_KEY=change-me-generate-on-server
HF_UI_S3_SECRET_KEY=change-me-generate-on-server
HF_UI_MODELS_BUCKET=${MINIO_STORAGE_BUCKET_MODELS}
HF_UI_DATASETS_BUCKET=${MINIO_STORAGE_BUCKET_DATASETS}
HF_UI_ARTIFACTS_BUCKET=${MINIO_STORAGE_BUCKET_ARTIFACTS}
HF_UI_PUBLIC_BUCKET=${MINIO_STORAGE_BUCKET_PUBLIC}
HF_UI_PRESIGN_EXPIRY_SECONDS=900
HF_UI_PREVIEW_MAX_ROWS=1000
HF_UI_PREVIEW_MAX_BYTES=5242880
HF_UI_PREVIEW_PARQUET_MAX_BYTES=20971520
HF_UI_PREVIEW_RETURN_ROWS=50

PHASE5_REQUIRE_REAL_DOMAINS=true
