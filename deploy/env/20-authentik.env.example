AUTHENTIK_IMAGE=ghcr.io/goauthentik/server:2025.2.4
AUTHENTIK_SECRET_KEY=change-me-generate-on-server
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.edu
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-generate-on-server
AUTHENTIK_BOOTSTRAP_TOKEN=change-me-generate-on-server
AUTHENTIK_POSTGRES_DB=authentik
AUTHENTIK_POSTGRES_USER=authentik_user
AUTHENTIK_POSTGRES_PASSWORD=change-me-generate-on-server
AUTHENTIK_REDIS_DB=0
AUTHENTIK_EMAIL__HOST=smtp.example.edu
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=change-me-on-server
AUTHENTIK_EMAIL__PASSWORD=change-me-on-server
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__FROM=authentik@example.edu
AUTHENTIK_CHECK_DISCOVERY_SLUGS=
AUTHENTIK_PHASE2_OIDC_APPS=huly,minio,hf-ui
AUTHENTIK_OIDC_POLICY_NAME=require-active-lab-user
AUTHENTIK_OIDC_SCOPES=openid,email,profile,groups
HULY_OIDC_CLIENT_ID=huly
HULY_OIDC_CLIENT_SECRET=change-me-generate-on-server
HULY_OIDC_REDIRECT_URIS=https://huly.lab.example.ac.kr/_accounts/auth/openid/callback
HULY_OIDC_APP_NAME=Huly
MINIO_OIDC_CLIENT_ID=minio
MINIO_OIDC_CLIENT_SECRET=change-me-generate-on-server
MINIO_OIDC_REDIRECT_URIS=https://${FILES_DOMAIN}/oauth_callback
MINIO_OIDC_APP_NAME="MinIO Console"
MINIO_OIDC_SCOPES=openid,email,profile,groups,policy
HF_UI_OIDC_CLIENT_ID=hf-ui
HF_UI_OIDC_CLIENT_SECRET=change-me-generate-on-server
HF_UI_OIDC_REDIRECT_URIS=https://${HF_DOMAIN}/oauth/callback
HF_UI_OIDC_APP_NAME="HF UI"
